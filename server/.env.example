# Copy to .env for local development. Values below match docker-compose.yml
# and db/init/00_init_roles.sql (DEV-ONLY credentials).

# Migration / owner role (runs Alembic; owns the tables).
MIGRATION_DATABASE_URL=postgresql+asyncpg://recycle_owner:owner_pw_dev@localhost:5544/recycle

# Application / runtime role (subject to RLS; used by the app and the proof).
APP_DATABASE_URL=postgresql+asyncpg://recycle_app:app_pw_dev@localhost:5544/recycle

# JWT signing secret. REQUIRED — the app refuses to start without it, and there
# is no default. Never commit a real value; generate a fresh one per deployment:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=3600
