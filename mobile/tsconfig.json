{
  // The EXPO APP program. Metro/babel do the actual bundling; this exists so
  // the app typechecks and the editor is accurate.
  //
  // Node-only files are excluded because pulling @types/node into this program
  // is what redefines URL and breaks React Native's globals (proven in 2b).
  // The mirror image lives in tsconfig.node.json, which excludes src/device.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["App.tsx", "index.ts", "app", "src"],
  "exclude": [
    "dist",
    "node_modules",
    "src/proof",
    "src/adapters/sqlite/nodeDriver.ts"
  ]
}
