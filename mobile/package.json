{
  "name": "recycle-online-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Recycle Online mobile client: Expo app, sync engine, storage adapters, and headless node proofs. ONE npm package on purpose โ€” nesting a second one inside it breaks Metro's file map.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.node.json && node tools/finish-build.mjs",
    "prove:sync": "npm run build && node dist/proof/proveSync.js",
    "prove:sqlite": "npm run build && node dist/proof/sqliteProof.js",
    "prove:money": "npm run build && node dist/proof/proveMoney.js",
    "prove:cart": "npm run build && node dist/proof/proveCart.js",
    "prove:entry": "npm run build && node dist/proof/proveEntry.js",
    "prove:seller": "npm run build && node dist/proof/proveSeller.js",
    "prove:notice": "npm run build && node dist/proof/proveNotice.js",
    "prove:void": "npm run build && node dist/proof/proveVoid.js",
    "prove:time": "npm run build && node dist/proof/proveTime.js",
    "prove:cold": "npm run build && node dist/proof/proveCold.js",
    "prove:clock": "npm run build && node dist/proof/proveClock.js",
    "prove:forbidden": "npm run build && node dist/proof/proveForbidden.js",
    "prove:daily": "npm run build && node dist/proof/proveDaily.js",
    "prove:signout": "npm run build && node dist/proof/proveSignOut.js"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
